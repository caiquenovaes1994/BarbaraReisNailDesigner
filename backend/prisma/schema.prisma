// Esquema do banco de dados

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Procedure {
  id            Int           @id @default(autoincrement())
  nome          String
  preco         Float
  duracao       Int           @default(60)
  ativo         Boolean       @default(true)
  criado_em     DateTime      @default(now()) @map("criado_em")
  atualizado_em DateTime      @default(now()) @updatedAt @map("atualizado_em")
  appointments  Appointment[]

  @@index([ativo])
  @@map("procedures")
}

model Customer {
  id              Int           @id @default(autoincrement())
  nome            String
  ddi             String        @default("55")
  telefone        String
  data_nascimento String?
  endereco        String?
  ativo           Boolean       @default(true)
  criado_em       DateTime      @default(now()) @map("criado_em")
  atualizado_em   DateTime      @default(now()) @updatedAt @map("atualizado_em")
  appointments    Appointment[]

  @@index([ativo])
  @@index([nome])
  @@map("customers")
}

model Appointment {
  id                 Int       @id @default(autoincrement())
  customerId         Int
  procedureId        Int
  data_atendimento   DateTime
  status             String    // Status do agendamento
  valor_cobrado      Float
  dias_para_retorno  Int
  duracao            Int       @default(60)
  retorno_dispensado Boolean   @default(false)
  extra_procedure_ids Json?    @default("[]")
  criado_em          DateTime  @default(now()) @map("criado_em")
  atualizado_em      DateTime  @default(now()) @updatedAt @map("atualizado_em")

  customer           Customer  @relation(fields: [customerId], references: [id])
  procedure          Procedure @relation(fields: [procedureId], references: [id])

  @@index([customerId])
  @@index([procedureId])
  @@index([data_atendimento])
  @@index([status, data_atendimento])
  @@map("appointments")
}


model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  nome          String   @default("")
  password      String
  criado_em     DateTime @default(now()) @map("criado_em")
  atualizado_em DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("users")
}

