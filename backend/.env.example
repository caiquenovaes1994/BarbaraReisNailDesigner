# Banco de dados PostgreSQL (ex: Supabase)
DATABASE_URL="postgres://usuario:senha@host:6543/postgres?pgbouncer=true&sslmode=verify-full&sslrootcert=../prod-ca-2021.crt"
DIRECT_URL="postgres://usuario:senha@host:5432/postgres?sslmode=verify-full&sslrootcert=../prod-ca-2021.crt"

# Segredo JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="substitua-por-uma-string-aleatoria-de-64+-caracteres"

# Timezone do servidor
TZ="America/Sao_Paulo"

# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:5174"

# Salt para derivação da chave de criptografia — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: Nunca altere após definido, ou os dados criptografados serão perdidos!
ENCRYPTION_SALT="substitua-por-um-salt-aleatorio-de-64-caracteres"

# Chave de criptografia (opcional — se não definida, usa JWT_SECRET como fallback)
# ENCRYPTION_KEY="substitua-por-uma-chave-aleatoria-de-64-caracteres"
