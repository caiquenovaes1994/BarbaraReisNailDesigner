# Banco de dados PostgreSQL (ex: Supabase)
DATABASE_URL="postgres://usuario:senha@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgres://usuario:senha@host:5432/postgres"

# Segredo JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="substitua-por-uma-string-aleatoria-de-64+-caracteres"

# Timezone do servidor
TZ="America/Sao_Paulo"

# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:5174"
